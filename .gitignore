report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk

# The report itself contains the author's name and student ID, so it is kept out of
# the public repository (submit it directly to the course submission system).
report/*.pdf
report/*.tex
