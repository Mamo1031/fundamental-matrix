# uv / Python
.venv/
__pycache__/
*.pyc

# 内部ワークフロー用（公開リポジトリには含めない）
CLAUDE.md
tasks/

# ユーザーが撮った入力画像（サンプルの data/aloe*.jpg は追跡する）
data/user/*
!data/user/.gitkeep

# 実行時の生成物（再生成可能。README 用のショーケース画像は assets/ に置く）
outputs/

# LaTeX のビルド成果物
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk

# レポート本体は氏名・学籍番号を含むため public リポジトリには入れない（課題提出システムへ直接提出）
report/*.pdf
report/*.tex
