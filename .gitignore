# uv / Python
.venv/
__pycache__/
*.pyc

# 内部ワークフロー用（公開リポジトリには含めない）
CLAUDE.md
tasks/

# ユーザーが撮った入力画像（サンプルの data/aloe*.jpg は追跡する）
data/user/*
!data/user/.gitkeep

# 実行時の生成物（再生成可能。README 用のショーケース画像は assets/ に置く）
outputs/

# LaTeX のビルド成果物（report/report.pdf は成果物として追跡する）
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk
